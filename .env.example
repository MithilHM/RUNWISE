# Environment Configuration for RUNWISE
APP_NAME=RUNWISE
DEBUG=False
API_V1_STR=/api/v1

# FalkorDB Database Configuration
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=runwise
FALKORDB_PASSWORD=
FALKORDB_SSL=False
FALKORDB_TIMEOUT_MS=5000
FALKORDB_MAX_CONNECTIONS=20

# Browser origins allowed to call the API (comma separated).
# The Vite dev server default is http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM client for natural-language explanation.
# Leave RUNWISE_LLM_API_KEY unset: the app then answers deterministically and
# reports mode="deterministic", llm_used=false. Never commit a real key.
RUNWISE_LLM_API_KEY=
RUNWISE_LLM_MODEL=gpt-4o-mini
RUNWISE_LLM_BASE_URL=https://api.openai.com/v1
